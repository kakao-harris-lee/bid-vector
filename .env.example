# Database Configuration
DATABASE_URL=postgresql+psycopg://biduser:bidpassword@localhost:5432/bid_vector_db
DATABASE_USER=biduser
DATABASE_PASSWORD=bidpassword
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=bid_vector_db

# Server Configuration
DEBUG=true
API_PORT=8000
API_HOST=0.0.0.0

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Background Job Configuration
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=cache+memory://
OPERATOR_STRATEGY_MONITOR_SCHEDULE_ENABLED=false
OPERATOR_STRATEGY_MONITOR_INTERVAL_MINUTES=30
OPERATOR_STRATEGY_MONITOR_RUN_ON_STARTUP=false
OPERATOR_STRATEGY_MONITOR_SCHEDULE_LIMIT=10
OPERATOR_STRATEGY_MONITOR_SCHEDULE_HIGH_PRIORITY_ONLY=true
OPERATOR_STRATEGY_MONITOR_SCHEDULE_MAX_ACTIVE_BIDS=3
OPERATOR_STRATEGY_MONITOR_SCHEDULE_CURRENT_WORKLOAD_SCORE=0.0
OPERATOR_STRATEGY_MONITOR_SCHEDULE_SAME_CATEGORY_ONLY=true
OPERATOR_STRATEGY_MONITOR_SCHEDULE_SIMILAR_LIMIT=3
OPERATOR_STRATEGY_MONITOR_SCHEDULE_MIN_SIMILARITY=0.15

# AI Model Configuration
MODEL_CACHE_DIR=./models
ENABLE_PRICE_PREDICTION=true
ENABLE_BID_RECOMMENDATION=true
ENABLE_DOCUMENT_ANALYSIS=true
ENABLE_SEMANTIC_CLASSIFICATION=true
CLASSIFIER_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CLASSIFIER_EMBEDDING_LOCAL_FILES_ONLY=true
CLASSIFIER_SEMANTIC_MATCH_THRESHOLD=0.35

# KONEPS Crawling Configuration
KONEPS_HOME_URL=https://www.g2b.go.kr/
KONEPS_NOTICE_LIST_URL=https://www.g2b.go.kr/pt/menu/selectSubFrame.do?framesrc=/ep/tbid/tbidList.do
KONEPS_HEADLESS=true
KONEPS_TIMEOUT_MS=30000
KONEPS_USER_AGENT=bid-vector-bot/0.1
KONEPS_REQUEST_DELAY_MS=750
KONEPS_SEARCH_WAIT_MS=4000
KONEPS_MAX_ITEMS=10
KONEPS_RETRY_COUNT=2
KONEPS_RETRY_BACKOFF_MS=1500

# Telegram Configuration
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
TELEGRAM_BOT_USERNAME=replace-with-your-bot-username
TELEGRAM_CHAT_ID=replace-with-target-chat-id
TELEGRAM_SEND_TIMEOUT_SECONDS=10
TELEGRAM_DECISION_PRIORITY_THRESHOLD=0.78
TELEGRAM_DECISION_PROBABILITY_THRESHOLD=0.80
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-secret-token
TELEGRAM_POLLING_LIMIT=20
TELEGRAM_POLLING_TIMEOUT_SECONDS=0

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Environment
ENVIRONMENT=development
