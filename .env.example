# Database Configuration
DATABASE_URL=postgresql+psycopg://biduser:bidpassword@localhost:5432/bid_vector_db
DATABASE_USER=biduser
DATABASE_PASSWORD=bidpassword
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=bid_vector_db

# Server Configuration
DEBUG=true
API_PORT=3000
API_HOST=0.0.0.0

# Docker Build Target
# api-runtime: slim default API image (embedding falls back to hash — not for production)
# api-embedding: API image with sentence-transformer embedding stack (RECOMMENDED for production)
# api-training: API image with training/data-science stack
# api-ml-full: API image with both embedding and training stacks
#
# Production note: keeping api-runtime in production disables semantic classification —
# every new project gets a hash-based fallback embedding and category auto-classification
# becomes unreliable. Use api-embedding unless you have a specific reason not to.
API_DOCKER_TARGET=api-embedding

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
OPERATOR_PASSWORD_RESET_TOKEN=replace-with-a-random-reset-token

# Background Job Configuration
# Keep the defaults below for zero-dependency local development.
# When you switch CELERY_BROKER_URL away from memory://, the application will
# automatically use db+${DATABASE_URL} as the result backend unless you set an
# explicit CELERY_RESULT_BACKEND.
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=cache+memory://
CELERY_TASK_DEFAULT_QUEUE=bid_vector
CELERY_OPS_QUEUE=bid_vector_ops
CELERY_ML_BACKFILL_QUEUE=bid_vector_ml_backfill
CELERY_ML_TRAINING_QUEUE=bid_vector_ml_training
CELERY_ML_REEVALUATION_QUEUE=bid_vector_ml_reevaluation
CELERY_ALLOW_INLINE_ML_TASKS=false
CELERY_WORKER_CONCURRENCY=2
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=100
CELERY_TASK_TIME_LIMIT_SECONDS=1800
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=1500
CELERY_RESULT_EXPIRES_SECONDS=86400
CELERY_TASK_TRACK_STARTED=true
CELERY_WORKER_SEND_TASK_EVENTS=true
CELERY_TASK_SEND_SENT_EVENT=true
CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP=true
CELERY_BROKER_CONNECTION_MAX_RETRIES=100
CELERY_BROKER_PUBLISH_MAX_RETRIES=3
REALTIME_REQUIRE_AUTH=true
REALTIME_FANOUT_BACKEND=local
REALTIME_POSTGRES_CHANNEL=bid_vector_realtime_events
REALTIME_HISTORY_LIMIT=100
# Optional Docker Compose RabbitMQ profile defaults
CELERY_RABBITMQ_USER=bidvector
CELERY_RABBITMQ_PASSWORD=bidvector
CELERY_RABBITMQ_VHOST=bidvector
CELERY_RABBITMQ_PORT=5672
CELERY_RABBITMQ_MANAGEMENT_PORT=15672
OPERATOR_STRATEGY_MONITOR_SCHEDULE_ENABLED=false
OPERATOR_STRATEGY_MONITOR_INTERVAL_MINUTES=30
OPERATOR_STRATEGY_MONITOR_RUN_ON_STARTUP=false
OPERATOR_STRATEGY_MONITOR_SCHEDULE_LIMIT=10
OPERATOR_STRATEGY_MONITOR_SCHEDULE_HIGH_PRIORITY_ONLY=true
OPERATOR_STRATEGY_MONITOR_SCHEDULE_MAX_ACTIVE_BIDS=3
OPERATOR_STRATEGY_MONITOR_SCHEDULE_CURRENT_WORKLOAD_SCORE=0.0
OPERATOR_STRATEGY_MONITOR_SCHEDULE_SAME_CATEGORY_ONLY=true
OPERATOR_STRATEGY_MONITOR_SCHEDULE_SIMILAR_LIMIT=3
OPERATOR_STRATEGY_MONITOR_SCHEDULE_MIN_SIMILARITY=0.15
PAPER_BIDDING_FORWARD_SCHEDULE_ENABLED=false
PAPER_BIDDING_FORWARD_RUN_ON_STARTUP=false
PAPER_BIDDING_FORWARD_INTERVAL_MINUTES=1440
PAPER_BIDDING_FORWARD_SCHEDULE_LIMIT=50
PAPER_BIDDING_FORWARD_SCHEDULE_CATEGORY=
PAPER_BIDDING_FORWARD_SCHEDULE_SCENARIO=base
PAPER_BIDDING_FORWARD_SCHEDULE_HISTORY_LIMIT=80
PAPER_BIDDING_FORWARD_SCHEDULE_PERSIST=true

# Historical backtest — replay awarded TenderResults as paper_bid + settlement.
# Activates the auto-evaluation cycle (paper_bid → settlement → price_only_won metrics).
# Settings.HISTORICAL_BACKTEST_LOOKBACK_DAYS window slides daily so recent awards are
# continuously re-evaluated against the current predictor.
HISTORICAL_BACKTEST_SCHEDULE_ENABLED=false
HISTORICAL_BACKTEST_INTERVAL_MINUTES=1440
HISTORICAL_BACKTEST_LOOKBACK_DAYS=30
HISTORICAL_BACKTEST_SCHEDULE_LIMIT=100
HISTORICAL_BACKTEST_SCHEDULE_CATEGORY=
HISTORICAL_BACKTEST_SCHEDULE_SCENARIO=base
HISTORICAL_BACKTEST_SCHEDULE_HISTORY_LIMIT=80
HISTORICAL_BACKTEST_SCHEDULE_CUTOFF_HOURS=2
HISTORICAL_BACKTEST_SCHEDULE_SETTLE_ACTIONS=bid_now,review
HISTORICAL_BACKTEST_SCHEDULE_PERSIST=true

# KONEPS + Telegram end-to-end smoke test — fires daily at SMOKE_TEST_HOUR_UTC/MINUTE.
# 07:00 UTC = 16:00 KST. Default disabled — opt-in via .env to enable.
SMOKE_TEST_SCHEDULE_ENABLED=false
SMOKE_TEST_HOUR_UTC=7
SMOKE_TEST_MINUTE=0

# KONEPS notice collection — periodic crawl via Celery beat
# Set ENABLED=true to activate. INTERVAL_MINUTES controls cadence.
# SOURCE matches a value that KonepsCollectorService understands
# (koneps-openapi for the official API; koneps-scsbid for award/result backfill).
KONEPS_COLLECTION_SCHEDULE_ENABLED=false
KONEPS_COLLECTION_INTERVAL_MINUTES=60
KONEPS_COLLECTION_SOURCE=koneps-openapi
KONEPS_COLLECTION_CATEGORY=
KONEPS_COLLECTION_MAX_ITEMS=50
KONEPS_COLLECTION_EXECUTION_MODE=auto

# Business type enrichment — fills Project.business_type_code/label via detail HTML.
# Run periodically to backfill rows that the OpenAPI source returned without 업종 정보.
BUSINESS_TYPE_ENRICHMENT_SCHEDULE_ENABLED=false
BUSINESS_TYPE_ENRICHMENT_INTERVAL_MINUTES=15
BUSINESS_TYPE_ENRICHMENT_BATCH_LIMIT=50

# Category reclassification — SBERT prototype-based assignment for rows stuck at 'general'/'other'
# Requires api-embedding image (sentence-transformers + a real model) to do anything.
CATEGORY_RECLASSIFY_SCHEDULE_ENABLED=false
CATEGORY_RECLASSIFY_INTERVAL_MINUTES=30
CATEGORY_RECLASSIFY_BATCH_LIMIT=100

# ML Release Governance
ML_RELEASE_MANIFEST_DIR=models/manifests
ML_RELEASE_MANIFEST_ARCHIVE_DIR=models/manifests/archive
ML_RELEASE_MANIFEST_RETENTION_LIMIT=20
ML_RELEASE_MANIFEST_SIGNING_KEY=replace-with-release-manifest-signing-key
ML_RELEASE_MANIFEST_SIGNING_KEY_ID=local
ML_RELEASE_MANIFEST_REQUIRE_SIGNATURE=false
# Optional object storage target. Use file:///absolute/path for local archival
# or s3://bucket/prefix when boto3 and cloud credentials are available.
ML_RELEASE_OBJECT_STORAGE_URL=
ML_RELEASE_REMOTE_STORAGE_AUTO_PUBLISH=false

# AI Model Configuration
MODEL_CACHE_DIR=./models
ENABLE_PRICE_PREDICTION=true
ENABLE_BID_RECOMMENDATION=true
ENABLE_DOCUMENT_ANALYSIS=true
ENABLE_SEMANTIC_CLASSIFICATION=true
PRICE_PREDICTION_PREFERRED_PREDICTOR=historical
PRICE_PREDICTION_ENABLE_EXPERIMENTAL_PREDICTORS=false
PRICE_PREDICTION_LSTM_MODEL_PATH=
PRICE_PREDICTION_ENSEMBLE_MODEL_PATH=
# Local path is preferred so containers don't need network access at startup.
# Pre-download once on the host with:
#   from sentence_transformers import SentenceTransformer
#   SentenceTransformer('sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2') \
#       .save('models/sbert/paraphrase-multilingual-MiniLM-L12-v2')
# The `models/` directory is already volume-mounted to /app/models in every service.
CLASSIFIER_EMBEDDING_MODEL=/app/models/sbert/paraphrase-multilingual-MiniLM-L12-v2
CLASSIFIER_EMBEDDING_LOCAL_FILES_ONLY=true
CLASSIFIER_SEMANTIC_MATCH_THRESHOLD=0.35

# KONEPS Crawling Configuration
KONEPS_HOME_URL=https://www.g2b.go.kr/
KONEPS_NOTICE_LIST_URL=https://www.g2b.go.kr/pt/menu/selectSubFrame.do?framesrc=/ep/tbid/tbidList.do
KONEPS_OPENAPI_BID_PUBLIC_INFO_URL=https://apis.data.go.kr/1230000/ad/BidPublicInfoService
KONEPS_OPENAPI_SCSBID_INFO_URL=https://apis.data.go.kr/1230000/as/ScsbidInfoService
KONEPS_OPENAPI_SERVICE_KEY=replace-with-public-data-portal-service-key
KONEPS_OPENAPI_ENCODED_SERVICE_KEY=
KONEPS_OPENAPI_MAX_ITEMS=100
KONEPS_OPENAPI_TIMEOUT_SECONDS=20
KONEPS_HEADLESS=true
KONEPS_TIMEOUT_MS=30000
KONEPS_USER_AGENT=bid-vector-bot/0.1
KONEPS_REQUEST_DELAY_MS=750
KONEPS_SEARCH_WAIT_MS=4000
KONEPS_MAX_ITEMS=10
KONEPS_RETRY_COUNT=2
KONEPS_RETRY_BACKOFF_MS=1500

# Telegram Configuration
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
TELEGRAM_BOT_USERNAME=replace-with-your-bot-username
TELEGRAM_CHAT_ID=replace-with-target-chat-id
TELEGRAM_SEND_TIMEOUT_SECONDS=10
TELEGRAM_DECISION_PRIORITY_THRESHOLD=0.78
TELEGRAM_DECISION_PROBABILITY_THRESHOLD=0.80
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-secret-token
TELEGRAM_POLLING_LIMIT=20
TELEGRAM_POLLING_TIMEOUT_SECONDS=0

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Environment
ENVIRONMENT=development
